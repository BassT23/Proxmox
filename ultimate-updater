print_check_summary() {
  local target="$1" result="$2"
  python3 - "$STATUS_FILE" "$target" "$result" <<'PY'
import json
import sys

status_file, wanted, result = sys.argv[1:]
try:
    result = int(result)
except ValueError:
    result = 1

def fallback_label(value):
    return value.removeprefix("host:")

try:
    with open(status_file, encoding="utf-8") as source:
        payload = json.load(source)
except (OSError, ValueError):
    print(f"CHECK {fallback_label(wanted)} {'completed' if result == 0 else 'failed'}")
    raise SystemExit

target = None
for item in payload.get("targets", []):
    if not isinstance(item, dict):
        continue
    identifier = str(item.get("id") or "")
    if identifier == wanted or identifier.removeprefix("host:") == wanted:
        target = item
        break

if target is None:
    print(f"CHECK {fallback_label(wanted)} {'completed' if result == 0 else 'failed'}")
    raise SystemExit

identifier = str(target.get("id") or wanted)
short_id = identifier.removeprefix("host:")
name = str(target.get("name") or "")
label = short_id if not name or name in (identifier, short_id) else f"{short_id} · {name}"
if result != 0 or target.get("check_status") == "error":
    error = target.get("error") if isinstance(target.get("error"), dict) else {}
    code = str(error.get("code") or "CHECK_FAILED")
    message = " ".join(str(error.get("message") or "").split())
    suffix = f": {code} - {message}" if message else f": {code}"
    print(f"CHECK {label} failed{suffix}")
elif target.get("reachable") is False or target.get("check_status") == "offline":
    print(f"CHECK {label} offline")
else:
    updates = target.get("updates")
    available = updates.get("available") if isinstance(updates, dict) else None
    if isinstance(available, int) and not isinstance(available, bool):
        print(f"CHECK {label} completed: {available} updates available")
    else:
        print(f"CHECK {label} completed")
PY
}

print_global_check_summary() {
