PY
}

run_check() {
  local target="${1:-}" kind resolve_result check_result external_result
  if [[ -z "$target" ]]; then
    require_file "$CHECK_SCRIPT" "check script" || return 1
    local check_result external_result
    UU_DEFER_NOTIFICATION=true "$CHECK_SCRIPT"; check_result=$?
    run_external_checks; external_result=$?
    if declare -f STATUS_MODEL_SEND_NOTIFICATION >/dev/null 2>&1; then
      STATUS_MODEL_SEND_NOTIFICATION "$STATUS_FILE" "$LOCAL_FILES/update.conf" || true
    fi
    print_global_check_summary "$check_result" "$external_result"
    [[ "$check_result" -eq 0 ]] || return "$check_result"
    return "$external_result"
  fi
  resolve_target_kind "$target" >/dev/null
  resolve_result=$?
  kind="$RESOLVED_TARGET_KIND"
  if [[ "$resolve_result" -ne 0 ]]; then
    case "$resolve_result" in
      1) printf 'ultimate-updater: target not found: %s\n' "$target" >&2; return 3 ;;
      4) return 4 ;;
      *) return "$resolve_result" ;;
    esac
  fi
  if [[ "$RESOLVED_TARGET_LOCAL" == false ]]; then
    remote_target_check "$target" "$kind" "$RESOLVED_TARGET_NODE" "$RESOLVED_TARGET_HOST"
    check_result=$?
    print_check_summary "$target" "$check_result"
    return "$check_result"
  fi
  case "$kind" in
    host) require_file "$CHECK_SCRIPT" "check script" || return 1; UU_DEFER_NOTIFICATION=true STATUS_MODEL_PARTIAL=true "$CHECK_SCRIPT" chost; check_result=$? ;;
    container) require_file "$CHECK_SCRIPT" "check script" || return 1; UU_DEFER_NOTIFICATION=true STATUS_MODEL_PARTIAL=true "$CHECK_SCRIPT" ccontainer "$target"; check_result=$? ;;
    vm) require_file "$CHECK_SCRIPT" "check script" || return 1; UU_DEFER_NOTIFICATION=true STATUS_MODEL_PARTIAL=true "$CHECK_SCRIPT" cvm "$target"; check_result=$? ;;
    external) require_file "$EXTERNAL_APT_SCRIPT" "external Linux helper" || return 1; "$EXTERNAL_APT_SCRIPT" check "$target"; check_result=$? ;;
  esac
  print_check_summary "$target" "$check_result"
  return "$check_result"
}

run_update() {
  require_file "$JOB_RUNNER" "job runner" || return 1
  local target="${1:-}" kind override="${2:-false}"
  [[ -n "$target" ]] || { usage >&2; return 2; }
  [[ "$EUID" -eq 0 ]] || { printf 'ultimate-updater: update jobs require root\n' >&2; return 2; }
  resolve_target_kind "$target" >/dev/null
  local resolve_result=$?
  kind="$RESOLVED_TARGET_KIND"
  if [[ "$resolve_result" -ne 0 ]]; then
    case "$resolve_result" in
      1) printf 'ultimate-updater: target not found: %s\n' "$target" >&2; return 3 ;;
      4) return 4 ;;
      *) return "$resolve_result" ;;
    esac
  fi
  if [[ "$kind" == external ]]; then
    external_backup_gate "$target" "$override" || return $?
  fi
  if [[ "$RESOLVED_TARGET_LOCAL" == false ]]; then
    remote_target_update "$target" "$RESOLVED_TARGET_NODE" "$RESOLVED_TARGET_HOST"
    return $?
  fi
  case "$kind" in
    host|container|vm) require_file "$UPDATE_SCRIPT" "update script" || return 1; "$JOB_RUNNER" start "$UPDATE_SCRIPT" "$([[ "$kind" == host ]] && printf host || printf '%s' "$target")" ;;
    external) require_file "$EXTERNAL_APT_SCRIPT" "external Linux helper" || return 1; if [[ "$override" == true ]]; then UU_EXTERNAL_BACKUP_OVERRIDE=true "$JOB_RUNNER" start "$EXTERNAL_APT_SCRIPT" "$target"; else "$JOB_RUNNER" start "$EXTERNAL_APT_SCRIPT" "$target"; fi ;;
  esac
}

command="${1:-help}"
case "$command" in
  help|-h|--help)
    [[ $# -le 1 ]] || { usage >&2; exit 2; }
    usage
    ;;
  list)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    list_targets
    ;;
  status)
    case "${2:-}" in
      "") [[ $# -eq 1 ]] || { usage >&2; exit 2; }; status_human ;;
      --json) [[ $# -eq 2 ]] || { usage >&2; exit 2; }; status_json ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  config)
    [[ "${2:-}" == set && "${3:-}" == web-port && $# -eq 4 ]] || { usage >&2; exit 2; }
    require_file "$WEB_UI_PORT_SCRIPT" "Web UI port helper" || exit 1
    "$WEB_UI_PORT_SCRIPT" set "$4"
    ;;
  hardcore-test)
    [[ $# -ge 2 ]] || { usage >&2; exit 2; }
    require_file "$HARDCORE_TEST_SCRIPT" "Hardcore-Test helper" || exit 1
    shift
    "$HARDCORE_TEST_SCRIPT" "$@"
    ;;
  check)
    [[ $# -le 2 ]] || { usage >&2; exit 2; }
    run_check "${2:-}"
    ;;
  update)
    [[ $# -eq 2 || ( $# -eq 3 && "$3" == "--without-verified-backup" ) ]] || { usage >&2; exit 2; }
    if [[ $# -eq 3 ]]; then run_update "$2" true; else run_update "$2" false; fi
    ;;
  update-all)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    external_backup_blockers || exit $?
    require_file "$JOB_RUNNER" "job runner" || exit 1
    require_file "$UPDATE_SCRIPT" "update script" || exit 1
    require_file "$GLOBAL_UPDATE_SCRIPT" "global update dispatcher" || exit 1
    "$JOB_RUNNER" start-global "$GLOBAL_UPDATE_SCRIPT"
    ;;
  check-node)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    run_node_check "$2"
    ;;
  update-node)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    [[ "$EUID" -eq 0 ]] || { printf 'ultimate-updater: update jobs require root\n' >&2; exit 2; }
    run_node_update "$2"
    ;;
  external)
    case "${2:-}" in
      setup) [[ $# -eq 3 ]] || { usage >&2; exit 2; }; external_setup "$3" ;;
      verify-backup) [[ $# -eq 3 || $# -eq 4 ]] || { usage >&2; exit 2; }; external_verify_backup "$3" "${4:-}" ;;
      backup-status) [[ $# -eq 3 ]] || { usage >&2; exit 2; }; external_backup_status "$3" ;;
      settings-get) [[ $# -eq 3 ]] || { usage >&2; exit 2; }; external_settings get "$3" ;;
      settings-set) [[ $# -ge 3 ]] || { usage >&2; exit 2; }; external_settings set "$3" "${@:4}" ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  *)
    printf 'ultimate-updater: unknown command: %s\n' "$command" >&2
    usage >&2
    exit 2
    ;;
esac
