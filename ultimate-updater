#!/bin/bash

# Small command frontend for the existing updater and check scripts.
# It deliberately owns dispatch and presentation only; target execution and
# status generation remain in the existing project scripts.

set -o pipefail

LOCAL_FILES="${UU_LOCAL_FILES:-/etc/ultimate-updater}"
SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
UPDATE_SCRIPT="$LOCAL_FILES/update.sh"
CHECK_SCRIPT="$LOCAL_FILES/check-updates.sh"
INVENTORY_SCRIPT="$LOCAL_FILES/target-inventory.sh"
JOB_RUNNER="$LOCAL_FILES/job-runner.sh"
STATUS_FILE="$LOCAL_FILES/status.json"
EXTERNAL_APT_SCRIPT="$LOCAL_FILES/external-apt.sh"
EXTERNAL_HELPER_FILE="$LOCAL_FILES/external-helper.sh"
EXTERNAL_BOOTSTRAP_FILE="$LOCAL_FILES/external-bootstrap.sh"
EXTERNAL_SAFETY_FILE="$LOCAL_FILES/external-backup-safety.sh"
STATUS_MODEL_SCRIPT="$LOCAL_FILES/status-model.sh"
CLUSTER_TARGET_SCRIPT="$LOCAL_FILES/cluster-target.sh"

if [[ ! -f "$UPDATE_SCRIPT" && -f "$SCRIPT_DIR/update.sh" ]]; then
  UPDATE_SCRIPT="$SCRIPT_DIR/update.sh"
fi
if [[ ! -f "$CHECK_SCRIPT" && -f "$SCRIPT_DIR/check-updates.sh" ]]; then
  CHECK_SCRIPT="$SCRIPT_DIR/check-updates.sh"
fi
if [[ ! -f "$INVENTORY_SCRIPT" && -f "$SCRIPT_DIR/target-inventory.sh" ]]; then
  INVENTORY_SCRIPT="$SCRIPT_DIR/target-inventory.sh"
fi
if [[ ! -f "$JOB_RUNNER" && -f "$SCRIPT_DIR/job-runner.sh" ]]; then
  JOB_RUNNER="$SCRIPT_DIR/job-runner.sh"
fi
if [[ ! -f "$EXTERNAL_APT_SCRIPT" && -f "$SCRIPT_DIR/external-apt.sh" ]]; then
  EXTERNAL_APT_SCRIPT="$SCRIPT_DIR/external-apt.sh"
fi
if [[ ! -f "$EXTERNAL_HELPER_FILE" && -f "$SCRIPT_DIR/external-helper.sh" ]]; then
  EXTERNAL_HELPER_FILE="$SCRIPT_DIR/external-helper.sh"
fi
if [[ ! -f "$EXTERNAL_BOOTSTRAP_FILE" && -f "$SCRIPT_DIR/external-bootstrap.sh" ]]; then
  EXTERNAL_BOOTSTRAP_FILE="$SCRIPT_DIR/external-bootstrap.sh"
fi
if [[ ! -f "$EXTERNAL_SAFETY_FILE" && -f "$SCRIPT_DIR/external-backup-safety.sh" ]]; then
  EXTERNAL_SAFETY_FILE="$SCRIPT_DIR/external-backup-safety.sh"
fi
if [[ ! -f "$STATUS_MODEL_SCRIPT" && -f "$SCRIPT_DIR/status-model.sh" ]]; then
  STATUS_MODEL_SCRIPT="$SCRIPT_DIR/status-model.sh"
fi
if [[ ! -f "$CLUSTER_TARGET_SCRIPT" && -f "$SCRIPT_DIR/cluster-target.sh" ]]; then
  CLUSTER_TARGET_SCRIPT="$SCRIPT_DIR/cluster-target.sh"
fi
# shellcheck disable=SC1090
[[ -f "$STATUS_MODEL_SCRIPT" ]] && source "$STATUS_MODEL_SCRIPT"
# shellcheck disable=SC1090
[[ -f "$CLUSTER_TARGET_SCRIPT" ]] && source "$CLUSTER_TARGET_SCRIPT"

usage() {
  cat <<EOF
Usage: $(basename "$0") COMMAND [TARGET|OPTIONS]

Commands:
  list                    List known local Proxmox and inventory targets
  check [TARGET]          Run the existing check, optionally for one target
  update TARGET [--without-verified-backup]
                          Start an update job; External targets require recent backup verification
  update-all              Start the configured cluster-wide update job
  check-node NODE         Check one Proxmox node and its configured guests
  update-node NODE        Update one Proxmox node and its configured guests
  status                  Show the latest machine-readable status summary
  status --json           Print the existing status JSON unchanged
  help                    Show this help

Legacy ./update.sh and ./check-updates.sh invocations remain supported.
Proxmox and external SSH apt/dnf updates use the session-independent #316 job runner.
EOF
}

require_file() {
  local file="$1" description="$2"
  if [[ ! -f "$file" ]]; then
    printf 'ultimate-updater: %s is not available: %s\n' "$description" "$file" >&2
    return 1
  fi
}

list_inventory() {
  local inventory_file="$LOCAL_FILES/targets.conf"
  [[ -f "$inventory_file" ]] || return 0
  if [[ ! -f "$INVENTORY_SCRIPT" ]]; then
    printf 'Inventory parser is not available: %s\n' "$INVENTORY_SCRIPT" >&2
    return 1
  fi
  if ! TARGET_INVENTORY_FILE="$inventory_file" bash -c \
    'source "$1" && TARGET_INVENTORY_VALIDATE "$2"' _ "$INVENTORY_SCRIPT" "$inventory_file"; then
    printf 'Target inventory is invalid: %s\n' "$inventory_file" >&2
    return 1
  fi
  TARGET_INVENTORY_FILE="$inventory_file" bash -c '
    source "$1"
    TARGET_INVENTORY_VALIDATE "$2" || exit 1
    for target in "${TARGET_NAMES[@]}"; do
      printf "%-18s %-12s %-8s\n" "$target" "external" "${TARGET_TRANSPORT[$target]}"
    done
  ' _ "$INVENTORY_SCRIPT" "$inventory_file"
}

list_proxmox() {
  if command -v pct >/dev/null 2>&1; then
    pct list 2>/dev/null | awk 'NR > 1 {printf "%-18s %-12s %-8s\n", $1, "lxc", "pct"}'
  fi
  if command -v qm >/dev/null 2>&1; then
    qm list 2>/dev/null | awk 'NR > 1 {printf "%-18s %-12s %-8s\n", $1, "vm", "qga/ssh"}'
  fi
}

list_targets() {
  printf '%-18s %-12s %-8s\n' "Target" "Type" "Transport"
  printf '%-18s %-12s %-8s\n' "------" "----" "---------"
  printf '%-18s %-12s %-8s\n' "local-host" "host" "local"
  list_proxmox
  list_inventory
}

external_setup() {
  local target="$1" inventory_file="$LOCAL_FILES/targets.conf"
  local key_path=/root/.ssh/ultimate-updater-external pub_path host port user identity_file
  local ssh_rc fingerprint
  [[ -f "$INVENTORY_SCRIPT" ]] || { printf 'Target inventory parser is not available.\n' >&2; return 1; }
  [[ -f "$EXTERNAL_HELPER_FILE" && -f "$EXTERNAL_BOOTSTRAP_FILE" ]] || {
    printf 'External setup files are not installed.\n' >&2
    return 1
  }
  # shellcheck disable=SC1090
  source "$INVENTORY_SCRIPT"
  TARGET_INVENTORY_VALIDATE "$inventory_file" || {
    printf 'Invalid target inventory: %s\n' "$TARGET_INVENTORY_ERROR" >&2
    return 1
  }
  [[ -n "${TARGET_TRANSPORT[$target]:-}" && "${TARGET_TRANSPORT[$target]}" == ssh ]] || {
    printf 'External SSH target not found: %s\n' "$target" >&2
    return 3
  }
  host="${TARGET_HOST[$target]}"
  port="${TARGET_PORT[$target]:-22}"
  user="${TARGET_USER[$target]:-root}"
  identity_file="${TARGET_IDENTITY_FILE[$target]:-}"
  pub_path="${key_path}.pub"

  install -d -m 0700 /root/.ssh
  if [[ ! -f "$key_path" ]]; then
    ssh-keygen -q -t ed25519 -N '' -C "ultimate-updater-external@$(hostname -s)" -f "$key_path" || return 1
    chmod 600 "$key_path"
    chmod 644 "$pub_path"
    printf 'Created dedicated External key: %s\n' "$key_path"
  fi
  [[ -r "$key_path" && -r "$pub_path" ]] || { printf 'External key is not readable.\n' >&2; return 1; }

  printf 'Target: %s (%s@%s:%s)\n' "$target" "$user" "$host" "$port"
  printf 'Public key:\n'
  cat "$pub_path"
  fingerprint=$(ssh-keygen -lf "$pub_path" -E sha256 | awk '{print $2}')
  printf 'Fingerprint: %s\n' "$fingerprint"
  if [[ -n "$identity_file" && "$identity_file" != "$key_path" ]]; then
    printf 'Configured identity_file differs: %s\n' "$identity_file"
  fi

  if ssh -q -o BatchMode=yes -o IdentitiesOnly=yes -o ConnectTimeout=5 \
    -i "$key_path" -p "$port" "$user@$host" true >/dev/null 2>&1; then
    ssh_rc=0
  else
    ssh_rc=$?
  fi
  if [[ "$ssh_rc" -ne 0 ]]; then
    printf 'State: KEY_NOT_AUTHORIZED or SSH_UNAVAILABLE (rc=%s)\n' "$ssh_rc"
  else
    printf 'State: SSH_READY\n'
  fi
  [[ -n "$identity_file" ]] || printf 'Runtime config must contain: identity_file=%s\n' "$key_path"
  printf 'Bootstrap (administrator runs this on the External host):\n'
  printf '  scp -i %q %q %q %s@%s:/tmp/\n' "$key_path" "$EXTERNAL_BOOTSTRAP_FILE" "$EXTERNAL_HELPER_FILE" "$user" "$host"
  printf '  sudo /tmp/external-bootstrap.sh /tmp/external-helper.sh %s\n' "$user"
  printf 'The bootstrap installs the root-owned helper and /etc/sudoers.d/ultimate-updater after visudo validation.\n'
}

external_target_is_configured() {
  local target="$1"
  [[ -f "$INVENTORY_SCRIPT" && -f "$EXTERNAL_SAFETY_FILE" ]] || return 1
  # shellcheck disable=SC1090
  source "$INVENTORY_SCRIPT"
  TARGET_INVENTORY_VALIDATE "$LOCAL_FILES/targets.conf" >/dev/null 2>&1 || return 1
  [[ "${TARGET_TRANSPORT[$target]:-}" == ssh ]]
}

external_verify_backup() {
  local target="$1" reference="${2:-}"
  external_target_is_configured "$target" || {
    printf 'External SSH target not found: %s\n' "$target" >&2
    return 3
  }
  "$EXTERNAL_SAFETY_FILE" verify "$target" "$reference"
}

external_backup_status() {
  local target="$1"
  external_target_is_configured "$target" || {
    printf 'External SSH target not found: %s\n' "$target" >&2
    return 3
  }
  "$EXTERNAL_SAFETY_FILE" status "$target"
}

external_backup_gate() {
  local target="$1" override="${2:-false}"
  external_target_is_configured "$target" || return 0
  if [[ "$override" == true ]]; then
    "$EXTERNAL_SAFETY_FILE" check "$target" --override
  else
    "$EXTERNAL_SAFETY_FILE" check "$target"
  fi
}

external_backup_blockers() {
  local target blockers=""
  [[ -f "$EXTERNAL_SAFETY_FILE" && -f "$INVENTORY_SCRIPT" ]] || return 0
  # shellcheck disable=SC1090
  source "$INVENTORY_SCRIPT"
  TARGET_INVENTORY_VALIDATE "$LOCAL_FILES/targets.conf" >/dev/null 2>&1 || return 1
  for target in "${TARGET_NAMES[@]}"; do
    [[ "${TARGET_TRANSPORT[$target]:-}" == ssh ]] || continue
    if ! "$EXTERNAL_SAFETY_FILE" check "$target" >/dev/null 2>&1; then
      blockers+="${blockers:+, }$target"
    fi
  done
  [[ -z "$blockers" ]] || {
    printf 'Blocked external targets: %s\n' "$blockers" >&2
    printf 'Reason: no verified recent backup.\n' >&2
    return 41
  }
}

inventory_target_exists() {
  local target="$1" inventory_file="$LOCAL_FILES/targets.conf"
  [[ -f "$inventory_file" && -f "$INVENTORY_SCRIPT" ]] || return 1
  TARGET_INVENTORY_FILE="$inventory_file" bash -c '
    source "$1"
    TARGET_INVENTORY_VALIDATE "$2" >/dev/null 2>&1 || exit 1
    for target in "${TARGET_NAMES[@]}"; do
      [[ "$target" == "$3" ]] && exit 0
    done
    exit 1
  ' _ "$INVENTORY_SCRIPT" "$inventory_file" "$target"
}

inventory_targets() {
  local inventory_file="$LOCAL_FILES/targets.conf"
  [[ -f "$inventory_file" && -f "$INVENTORY_SCRIPT" ]] || return 0
  TARGET_INVENTORY_FILE="$inventory_file" bash -c '
    source "$1"
    TARGET_INVENTORY_VALIDATE "$2" || exit 1
    printf "%s\n" "${TARGET_NAMES[@]}"
  ' _ "$INVENTORY_SCRIPT" "$inventory_file"
}

status_json() {
  require_file "$STATUS_FILE" "status file" || return 4
  if ! python3 - "$STATUS_FILE" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as status_file:
    json.load(status_file)
PY
  then
    printf 'ultimate-updater: status file is not valid JSON: %s\n' "$STATUS_FILE" >&2
    return 4
  fi
  cat "$STATUS_FILE"
}

status_human() {
  local status_result=0
  if [[ ! -f "$STATUS_FILE" ]]; then
    printf 'ultimate-updater: status file is not available: %s\n' "$STATUS_FILE" >&2
    status_result=4
  elif ! python3 - "$STATUS_FILE" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as status_file:
        payload = json.load(status_file)
except (OSError, ValueError) as error:
    print(f"ultimate-updater: cannot read status file: {error}", file=sys.stderr)
    raise SystemExit(4)

targets = payload.get("targets")
if not isinstance(targets, list):
    print("ultimate-updater: status file has no target list", file=sys.stderr)
    raise SystemExit(4)

print(f"Status schema {payload.get('schema_version', 'unknown')}" )
print(f"Generated: {payload.get('generated_at') or 'unknown'}")
print(f"{'Target':<18} {'Reachable':<11} {'Updates':<9} {'Status':<18} Last check")
print(f"{'------':<18} {'---------':<11} {'-------':<9} {'------':<18} ----------")
for target in targets:
    updates = target.get("updates") or {}
    available = updates.get("available")
    reachable = target.get("reachable")
    reachable_text = "yes" if reachable is True else "no" if reachable is False else "unknown"
    updates_text = str(available) if available is not None else "unknown"
    print(f"{str(target.get('id') or 'unknown'):<18} {reachable_text:<11} "
          f"{updates_text:<9} {str(target.get('check_status') or 'not_checked'):<18} "
          f"{target.get('last_check') or 'unknown'}")
PY
  then
    printf 'ultimate-updater: status file is not valid or readable: %s\n' "$STATUS_FILE" >&2
    status_result=4
  fi
  if [[ -x "$JOB_RUNNER" ]]; then
    local jobs
    jobs=$("$JOB_RUNNER" list 2>/dev/null || true)
    if [[ -n "$jobs" ]]; then
      printf '\nUpdate jobs\n'
      printf '%-55s %-12s %-20s %-12s %-20s\n' "Job" "Target" "State" "Exit" "Owner"
      while IFS=$'\t' read -r unit target state _ _ exit_code owner_node; do
        printf '%-55s %-12s %-20s %-12s %-20s\n' "$unit" "$target" "$state" "${exit_code:-pending}" "${owner_node:-local}"
      done <<< "$jobs"
    fi
  fi
  return "$status_result"
}

resolve_target_kind() {
  local target="$1" proxmox_kind="" inventory_kind=false cluster_rc
  RESOLVED_TARGET_KIND=""
  RESOLVED_TARGET_NODE=""
  RESOLVED_TARGET_HOST=""
  RESOLVED_TARGET_LOCAL=true
  if [[ "$target" == host || "$target" == local-host ]]; then
    RESOLVED_TARGET_KIND=host
    printf '%s\n' host
    return 0
  fi
  if declare -f cluster_target_resolve >/dev/null 2>&1 && cluster_target_is_id "$target" &&
    { [[ -n "${UU_CLUSTER_RESOURCES_JSON:-}" ]] || command -v pvesh >/dev/null 2>&1; }; then
    cluster_target_resolve "$target"
    cluster_rc=$?
    if [[ "$cluster_rc" -eq 0 ]]; then
      RESOLVED_TARGET_NODE="$CLUSTER_TARGET_NODE"
      RESOLVED_TARGET_HOST="$CLUSTER_TARGET_HOST"
      RESOLVED_TARGET_LOCAL="$CLUSTER_TARGET_LOCAL"
      RESOLVED_TARGET_KIND="$CLUSTER_TARGET_KIND"
      printf '%s\n' "$CLUSTER_TARGET_KIND"
      return 0
    fi
    if [[ "$cluster_rc" -eq 4 ]]; then
      printf 'ultimate-updater: target ID %s is ambiguous across the cluster.\n' "$target" >&2
      return 4
    fi
    if [[ "$cluster_rc" -eq 1 ]]; then
      return 1
    fi
    printf 'ultimate-updater: could not read the Proxmox cluster inventory.\n' >&2
    return 5
  fi
  if command -v pct >/dev/null 2>&1 && pct config "$target" >/dev/null 2>&1; then proxmox_kind=container; fi
  if command -v qm >/dev/null 2>&1 && qm config "$target" >/dev/null 2>&1; then proxmox_kind=vm; fi
  if inventory_target_exists "$target"; then inventory_kind=true; fi
  if [[ -n "$proxmox_kind" && "$inventory_kind" == true ]]; then
    printf 'ultimate-updater: target is ambiguous in Proxmox and inventory: %s\n' "$target" >&2
    return 4
  fi
  if [[ -n "$proxmox_kind" ]]; then RESOLVED_TARGET_KIND="$proxmox_kind"; printf '%s\n' "$proxmox_kind"; return 0; fi
  if [[ "$inventory_kind" == true ]]; then RESOLVED_TARGET_KIND=external; printf '%s\n' external; return 0; fi
  return 1
}

configured_ssh_port() {
  local config="$LOCAL_FILES/update.conf" port
  port=$(awk -F'"' '/^SSH_PORT=/ {print $2; exit}' "$config" 2>/dev/null || true)
  printf '%s\n' "${port:-22}"
}

cluster_node_resolve() {
  local wanted="$1" config=/etc/pve/corosync.conf result local_node local_ips
  [[ "$wanted" =~ ^[A-Za-z0-9_.-]+$ ]] || return 2
  [[ -f "$config" ]] || return 1
  result=$(python3 - "$config" "$wanted" <<'PY'
import re
import sys
path, wanted = sys.argv[1:]
try:
    text = open(path, encoding="utf-8").read()
except OSError:
    raise SystemExit(1)
for block in re.findall(r"node\s*\{(.*?)\}", text, re.S):
    name = re.search(r"\bname\s*:\s*([^\s}]+)", block)
    address = re.search(r"\bring0_addr\s*:\s*([^\s}]+)", block)
    if name and address and name.group(1) == wanted:
        print(f"{name.group(1)}\t{address.group(1)}")
        raise SystemExit(0)
raise SystemExit(1)
PY
  ) || return 1
  IFS=$'\t' read -r RESOLVED_NODE RESOLVED_NODE_HOST <<< "$result"
  local_node=$(cluster_target_local_node)
  local_ips=$(hostname -I 2>/dev/null || true)
  RESOLVED_NODE_LOCAL=false
  if [[ "${RESOLVED_NODE,,}" == "${local_node,,}" || " $local_ips " == *" $RESOLVED_NODE_HOST "* ]]; then
    RESOLVED_NODE_LOCAL=true
  fi
}

remote_node_check() {
  local node="$1" host="$2" remote_file local_file remote_config rc
  remote_file="/tmp/ultimate-updater-node-status-$$-$RANDOM.json"
  remote_config="/tmp/ultimate-updater-central-config-$$-$RANDOM.conf"
  local_file=$(mktemp)
  if ! STATUS_MODEL_INIT; then
    rm -f -- "$local_file"
    printf 'Could not initialize status model for node %s.\n' "$node" >&2
    return 1
  fi
  if ! timeout "${UU_CHECK_SSH_COMMAND_TIMEOUT:-15}" scp -q -o BatchMode=yes -o ConnectTimeout=5 \
    -P "$(configured_ssh_port)" "$LOCAL_FILES/update.conf" "$host:$remote_config" ||
    ! timeout "${UU_CHECK_SSH_COMMAND_TIMEOUT:-15}" ssh -q -o BatchMode=yes -o ConnectTimeout=5 -p "$(configured_ssh_port)" "$host" \
    "install -m 0640 '$remote_config' '$LOCAL_FILES/update.conf' && rm -f -- '$remote_config'" ||
    ! timeout "${UU_CHECK_SSH_COMMAND_TIMEOUT:-15}" ssh -q -o BatchMode=yes -o ConnectTimeout=5 -p "$(configured_ssh_port)" "$host" true ||
    ! timeout "${UU_CHECK_REMOTE_NODE_TIMEOUT:-300}" ssh -q -o BatchMode=yes -o ConnectTimeout=5 -p "$(configured_ssh_port)" "$host" \
    "UU_DEFER_NOTIFICATION=true STATUS_MODEL_PARTIAL=true STATUS_MODEL_NODE='$node' STATUS_MODEL_SCRIPT='/etc/ultimate-updater/status-model.sh' STATUS_MODEL_FILE='$remote_file' STATUS_MODEL_RECORD_FILE='$remote_file.records' bash '/etc/ultimate-updater/check-updates.sh' host >/dev/null 2>&1; cat '$remote_file'; rm -f -- '$remote_file' '$remote_file.records'" > "$local_file"; then
    timeout "${UU_CHECK_SSH_COMMAND_TIMEOUT:-15}" ssh -q -o BatchMode=yes -o ConnectTimeout=5 -p "$(configured_ssh_port)" "$host" \
      "rm -f -- '$remote_config' '$remote_file' '$remote_file.records'" >/dev/null 2>&1 || true
    STATUS_MODEL_RECORD "host:$node" host ssh false "" "" "null" "null" offline SSH_UNREACHABLE "Node $node is unreachable" "$node" "$node"
    STATUS_MODEL_FINISH >/dev/null 2>&1 || true
    rm -f -- "$local_file"
    printf 'Node %s is unreachable.\n' "$node" >&2
    return 1
  fi
  if ! STATUS_MODEL_IMPORT_FILE "$local_file"; then
    STATUS_MODEL_RECORD "host:$node" host ssh true "" "" "null" "null" error REMOTE_STATUS_IMPORT_FAILED "Could not import remote check status" "$node" "$node"
    STATUS_MODEL_FINISH >/dev/null 2>&1 || true
    rm -f -- "$local_file"
    printf 'Could not import status from node %s.\n' "$node" >&2
    return 1
  fi
  if ! STATUS_MODEL_FINISH; then
    rm -f -- "$local_file"
    printf 'Could not finalize status for node %s.\n' "$node" >&2
    return 1
  fi
  rm -f -- "$local_file"
}

run_node_check() {
  local node="$1"
  cluster_node_resolve "$node" || { printf 'Unknown Proxmox node: %s\n' "$node" >&2; return 3; }
  if [[ "$RESOLVED_NODE_LOCAL" == true ]]; then
    require_file "$CHECK_SCRIPT" "check script" || return 1
    STATUS_MODEL_PARTIAL=true "$CHECK_SCRIPT" host
  else
    STATUS_MODEL_PARTIAL=true remote_node_check "$RESOLVED_NODE" "$RESOLVED_NODE_HOST"
  fi
}

remote_node_update() {
  local node="$1" host="$2" port output job_unit target="node-$1" command
  port=$(configured_ssh_port)
  printf -v command 'exec /usr/bin/env UU_DEFER_NOTIFICATION=true %q start %q %q' "/etc/ultimate-updater/job-runner.sh" "/etc/ultimate-updater/update.sh" host
  if ! output=$(ssh -q -o BatchMode=yes -o ConnectTimeout=5 -p "$port" "$host" "$command"); then
    printf 'Could not start update job on %s.\n' "$node" >&2
    return 6
  fi
  printf '%s\n' "$output"
  job_unit=$(printf '%s\n' "$output" | sed -n 's/^Job:[[:space:]]*//p' | head -n 1)
  if [[ ! "$job_unit" =~ ^ultimate-updater-update-[A-Za-z0-9_.-]+$ ]] ||
    ! "$JOB_RUNNER" record-remote "$job_unit" "$target" "$node" "$host" "$port"; then
    printf 'Remote job started but could not be referenced locally.\n' >&2
    return 7
  fi
}

run_node_update() {
  local node="$1"
  cluster_node_resolve "$node" || { printf 'Unknown Proxmox node: %s\n' "$node" >&2; return 3; }
  require_file "$JOB_RUNNER" "job runner" || return 1
  if [[ "$RESOLVED_NODE_LOCAL" == true ]]; then
    require_file "$UPDATE_SCRIPT" "update script" || return 1
    "$JOB_RUNNER" start "$UPDATE_SCRIPT" host
  else
    remote_node_update "$RESOLVED_NODE" "$RESOLVED_NODE_HOST"
  fi
}

finish_partial_status() {
  local result=$1
  if declare -f STATUS_MODEL_FINISH >/dev/null 2>&1; then
    STATUS_MODEL_PARTIAL=true STATUS_MODEL_FINISH || result=$?
  fi
  return "$result"
}

record_remote_target_error() {
  local target="$1" kind="$2" node="$3" code="$4" message="$5" result=${6:-1}
  if declare -f STATUS_MODEL_INIT >/dev/null 2>&1 && STATUS_MODEL_INIT; then
    STATUS_MODEL_RECORD "$target" "$kind" ssh false "" "" null null offline "$code" "$message" "$node"
    finish_partial_status "$result"
  fi
  return "$result"
}

remote_target_check() {
  local target="$1" kind="$2" node="$3" host="$4" port mode remote_file local_file rc remote_check_script
  port=$(configured_ssh_port)
  mode=$([[ "$kind" == container ]] && printf ccontainer || printf cvm)
  remote_check_script="/etc/ultimate-updater/check-updates.sh"
  remote_file="/tmp/ultimate-updater-target-status-$$-$RANDOM.json"
  local_file=$(mktemp)
  ssh -q -o BatchMode=yes -o ConnectTimeout=5 -p "$port" "$host" true
  rc=$?
  if [[ "$rc" -ne 0 ]]; then
    rm -f -- "$local_file"
    printf 'Target %s is located on %s, but the node is unreachable.\n' "$target" "$node" >&2
    record_remote_target_error "$target" "$kind" "$node" SSH_UNREACHABLE "Could not run remote check on $node" "$rc"
    return "$rc"
  fi
  ssh -q -o BatchMode=yes -o ConnectTimeout=5 -p "$port" "$host" \
    "UU_DEFER_NOTIFICATION=true STATUS_MODEL_PARTIAL=true STATUS_MODEL_NODE='$node' STATUS_MODEL_FILE='$remote_file' STATUS_MODEL_RECORD_FILE='$remote_file.records' bash '$remote_check_script' '$mode' '$target' >/dev/null 2>&1"
  rc=$?
  if ! ssh -q -o BatchMode=yes -o ConnectTimeout=5 -p "$port" "$host" \
    "cat '$remote_file'; rm -f -- '$remote_file' '$remote_file.records'" > "$local_file"; then
    rm -f -- "$local_file"
    record_remote_target_error "$target" "$kind" "$node" REMOTE_STATUS_IMPORT_FAILED "Could not retrieve remote check status" 1
    return 1
  fi
  if ! python3 - "$local_file" "$target" > "${local_file}.filtered" <<'PY'
import json
import sys

source, wanted = sys.argv[1:]
with open(source, encoding="utf-8") as handle:
    payload = json.load(handle)
targets = [item for item in payload.get("targets", [])
           if isinstance(item, dict) and str(item.get("id")) == wanted]
if len(targets) != 1:
    raise SystemExit(1)
json.dump({"schema_version": payload.get("schema_version", 1),
           "targets": targets}, sys.stdout)
PY
  then
    rm -f -- "$local_file" "${local_file}.filtered"
    record_remote_target_error "$target" "$kind" "$node" REMOTE_STATUS_IMPORT_FAILED "Remote status did not contain target $target" 1
    return 1
  fi
  if ! STATUS_MODEL_INIT || ! STATUS_MODEL_IMPORT_FILE "${local_file}.filtered"; then
    rm -f -- "$local_file" "${local_file}.filtered"
    return 1
  fi
  rm -f -- "$local_file" "${local_file}.filtered"
  finish_partial_status "$rc"
}

remote_target_update() {
  local target="$1" node="$2" host="$3" port command output job_unit
  port=$(configured_ssh_port)
  printf 'Target %s resolved to %s.\n' "$target" "$node"
  printf 'Starting update job on %s ...\n' "$node"
  printf -v command 'exec /usr/bin/env UU_DEFER_NOTIFICATION=true %q start %q %q' \
    "/etc/ultimate-updater/job-runner.sh" "/etc/ultimate-updater/update.sh" "$target"
  if ! output=$(ssh -q -o BatchMode=yes -o ConnectTimeout=5 -p "$port" "$host" "$command"); then
    printf 'ultimate-updater: could not start update job on %s.\n' "$node" >&2
    return 6
  fi
  printf '%s\n' "$output"
  job_unit=$(printf '%s\n' "$output" | sed -n 's/^Job:[[:space:]]*//p' | head -n 1)
  if [[ ! "$job_unit" =~ ^ultimate-updater-update-[A-Za-z0-9_.-]+$ ]]; then
    printf 'ultimate-updater: remote update returned no valid job ID.\n' >&2
    return 6
  fi
  if ! "$JOB_RUNNER" record-remote "$job_unit" "$target" "$node" "$host" "$port"; then
    printf 'ultimate-updater: remote job started but its local reference could not be saved.\n' >&2
    return 7
  fi
}

run_external_checks() {
  local target result=0 targets
  targets=$(inventory_targets) || return 1
  [[ -n "$targets" ]] || return 0
  require_file "$EXTERNAL_APT_SCRIPT" "external Linux helper" || return 1
  while IFS= read -r target; do
    [[ -n "$target" ]] || continue
    "$EXTERNAL_APT_SCRIPT" check "$target" || result=$?
  done <<< "$targets"
  return "$result"
}

run_check() {
  local target="${1:-}" kind resolve_result
  if [[ -z "$target" ]]; then
    require_file "$CHECK_SCRIPT" "check script" || return 1
    local check_result external_result
    UU_DEFER_NOTIFICATION=true "$CHECK_SCRIPT"; check_result=$?
    run_external_checks; external_result=$?
    if declare -f STATUS_MODEL_SEND_NOTIFICATION >/dev/null 2>&1; then
      STATUS_MODEL_SEND_NOTIFICATION "$STATUS_FILE" "$LOCAL_FILES/update.conf" || true
    fi
    [[ "$check_result" -eq 0 ]] || return "$check_result"
    return "$external_result"
  fi
  resolve_target_kind "$target" >/dev/null
  resolve_result=$?
  kind="$RESOLVED_TARGET_KIND"
  if [[ "$resolve_result" -ne 0 ]]; then
    case "$resolve_result" in
      1) printf 'ultimate-updater: target not found: %s\n' "$target" >&2; return 3 ;;
      4) return 4 ;;
      *) return "$resolve_result" ;;
    esac
  fi
  if [[ "$RESOLVED_TARGET_LOCAL" == false ]]; then
    remote_target_check "$target" "$kind" "$RESOLVED_TARGET_NODE" "$RESOLVED_TARGET_HOST"
    return $?
  fi
  case "$kind" in
    host) require_file "$CHECK_SCRIPT" "check script" || return 1; STATUS_MODEL_PARTIAL=true "$CHECK_SCRIPT" chost ;;
    container) require_file "$CHECK_SCRIPT" "check script" || return 1; STATUS_MODEL_PARTIAL=true "$CHECK_SCRIPT" ccontainer "$target" ;;
    vm) require_file "$CHECK_SCRIPT" "check script" || return 1; STATUS_MODEL_PARTIAL=true "$CHECK_SCRIPT" cvm "$target" ;;
    external) require_file "$EXTERNAL_APT_SCRIPT" "external Linux helper" || return 1; "$EXTERNAL_APT_SCRIPT" check "$target" ;;
  esac
}

run_update() {
  require_file "$JOB_RUNNER" "job runner" || return 1
  local target="${1:-}" kind override="${2:-false}"
  [[ -n "$target" ]] || { usage >&2; return 2; }
  [[ "$EUID" -eq 0 ]] || { printf 'ultimate-updater: update jobs require root\n' >&2; return 2; }
  resolve_target_kind "$target" >/dev/null
  local resolve_result=$?
  kind="$RESOLVED_TARGET_KIND"
  if [[ "$resolve_result" -ne 0 ]]; then
    case "$resolve_result" in
      1) printf 'ultimate-updater: target not found: %s\n' "$target" >&2; return 3 ;;
      4) return 4 ;;
      *) return "$resolve_result" ;;
    esac
  fi
  if [[ "$kind" == external ]]; then
    external_backup_gate "$target" "$override" || return $?
  fi
  if [[ "$RESOLVED_TARGET_LOCAL" == false ]]; then
    remote_target_update "$target" "$RESOLVED_TARGET_NODE" "$RESOLVED_TARGET_HOST"
    return $?
  fi
  case "$kind" in
    host|container|vm) require_file "$UPDATE_SCRIPT" "update script" || return 1; "$JOB_RUNNER" start "$UPDATE_SCRIPT" "$([[ "$kind" == host ]] && printf host || printf '%s' "$target")" ;;
    external) require_file "$EXTERNAL_APT_SCRIPT" "external Linux helper" || return 1; if [[ "$override" == true ]]; then UU_EXTERNAL_BACKUP_OVERRIDE=true "$JOB_RUNNER" start "$EXTERNAL_APT_SCRIPT" "$target"; else "$JOB_RUNNER" start "$EXTERNAL_APT_SCRIPT" "$target"; fi ;;
  esac
}

command="${1:-help}"
case "$command" in
  help|-h|--help)
    [[ $# -le 1 ]] || { usage >&2; exit 2; }
    usage
    ;;
  list)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    list_targets
    ;;
  status)
    case "${2:-}" in
      "") [[ $# -eq 1 ]] || { usage >&2; exit 2; }; status_human ;;
      --json) [[ $# -eq 2 ]] || { usage >&2; exit 2; }; status_json ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  check)
    [[ $# -le 2 ]] || { usage >&2; exit 2; }
    run_check "${2:-}"
    ;;
  update)
    [[ $# -eq 2 || ( $# -eq 3 && "$3" == "--without-verified-backup" ) ]] || { usage >&2; exit 2; }
    if [[ $# -eq 3 ]]; then run_update "$2" true; else run_update "$2" false; fi
    ;;
  update-all)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    external_backup_blockers || exit $?
    require_file "$JOB_RUNNER" "job runner" || exit 1
    require_file "$UPDATE_SCRIPT" "update script" || exit 1
    "$JOB_RUNNER" start-global "$UPDATE_SCRIPT"
    ;;
  check-node)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    run_node_check "$2"
    ;;
  update-node)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    [[ "$EUID" -eq 0 ]] || { printf 'ultimate-updater: update jobs require root\n' >&2; exit 2; }
    run_node_update "$2"
    ;;
  external)
    case "${2:-}" in
      setup) [[ $# -eq 3 ]] || { usage >&2; exit 2; }; external_setup "$3" ;;
      verify-backup) [[ $# -eq 3 || $# -eq 4 ]] || { usage >&2; exit 2; }; external_verify_backup "$3" "${4:-}" ;;
      backup-status) [[ $# -eq 3 ]] || { usage >&2; exit 2; }; external_backup_status "$3" ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  *)
    printf 'ultimate-updater: unknown command: %s\n' "$command" >&2
    usage >&2
    exit 2
    ;;
esac
