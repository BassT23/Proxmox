import json
import sys

status_file, check_result, external_result = sys.argv[1:]
try:
    check_result = int(check_result)
    external_result = int(external_result)
except ValueError:
    check_result = external_result = 1
try:
    with open(status_file, encoding="utf-8") as source:
        payload = json.load(source)
except (OSError, ValueError):
    print(f"CHECK all systems {'completed' if check_result == 0 and external_result == 0 else 'failed'}")
    raise SystemExit

if check_result != 0 or external_result != 0:
    print("CHECK all systems failed")
    raise SystemExit
available = 0
known = True
for target in payload.get("targets", []):
    updates = target.get("updates") if isinstance(target, dict) else None
    value = updates.get("available") if isinstance(updates, dict) else None
    if isinstance(value, int) and not isinstance(value, bool):
