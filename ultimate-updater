#!/bin/bash

# Small command frontend for the existing updater and check scripts.
# It deliberately owns dispatch and presentation only; target execution and
# status generation remain in the existing project scripts.

set -o pipefail

LOCAL_FILES="${UU_LOCAL_FILES:-/etc/ultimate-updater}"
SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
UPDATE_SCRIPT="$LOCAL_FILES/update.sh"
CHECK_SCRIPT="$LOCAL_FILES/check-updates.sh"
INVENTORY_SCRIPT="$LOCAL_FILES/target-inventory.sh"
JOB_RUNNER="$LOCAL_FILES/job-runner.sh"
STATUS_FILE="$LOCAL_FILES/status.json"
EXTERNAL_APT_SCRIPT="$LOCAL_FILES/external-apt.sh"
STATUS_MODEL_SCRIPT="$LOCAL_FILES/status-model.sh"

if [[ ! -f "$UPDATE_SCRIPT" && -f "$SCRIPT_DIR/update.sh" ]]; then
  UPDATE_SCRIPT="$SCRIPT_DIR/update.sh"
fi
if [[ ! -f "$CHECK_SCRIPT" && -f "$SCRIPT_DIR/check-updates.sh" ]]; then
  CHECK_SCRIPT="$SCRIPT_DIR/check-updates.sh"
fi
if [[ ! -f "$INVENTORY_SCRIPT" && -f "$SCRIPT_DIR/target-inventory.sh" ]]; then
  INVENTORY_SCRIPT="$SCRIPT_DIR/target-inventory.sh"
fi
if [[ ! -f "$JOB_RUNNER" && -f "$SCRIPT_DIR/job-runner.sh" ]]; then
  JOB_RUNNER="$SCRIPT_DIR/job-runner.sh"
fi
if [[ ! -f "$EXTERNAL_APT_SCRIPT" && -f "$SCRIPT_DIR/external-apt.sh" ]]; then
  EXTERNAL_APT_SCRIPT="$SCRIPT_DIR/external-apt.sh"
fi
if [[ ! -f "$STATUS_MODEL_SCRIPT" && -f "$SCRIPT_DIR/status-model.sh" ]]; then
  STATUS_MODEL_SCRIPT="$SCRIPT_DIR/status-model.sh"
fi
# shellcheck disable=SC1090
[[ -f "$STATUS_MODEL_SCRIPT" ]] && source "$STATUS_MODEL_SCRIPT"

usage() {
  cat <<EOF
Usage: $(basename "$0") COMMAND [TARGET|OPTIONS]

Commands:
  list                    List known local Proxmox and inventory targets
  check [TARGET]          Run the existing check, optionally for one target
  update TARGET           Start a session-independent update job
  status                  Show the latest machine-readable status summary
  status --json           Print the existing status JSON unchanged
  help                    Show this help

Legacy ./update.sh and ./check-updates.sh invocations remain supported.
Proxmox and external SSH apt/dnf updates use the session-independent #316 job runner.
EOF
}

require_file() {
  local file="$1" description="$2"
  if [[ ! -f "$file" ]]; then
    printf 'ultimate-updater: %s is not available: %s\n' "$description" "$file" >&2
    return 1
  fi
}

list_inventory() {
  local inventory_file="$LOCAL_FILES/targets.conf"
  [[ -f "$inventory_file" ]] || return 0
  if [[ ! -f "$INVENTORY_SCRIPT" ]]; then
    printf 'Inventory parser is not available: %s\n' "$INVENTORY_SCRIPT" >&2
    return 1
  fi
  if ! TARGET_INVENTORY_FILE="$inventory_file" bash -c \
    'source "$1" && TARGET_INVENTORY_VALIDATE "$2"' _ "$INVENTORY_SCRIPT" "$inventory_file"; then
    printf 'Target inventory is invalid: %s\n' "$inventory_file" >&2
    return 1
  fi
  TARGET_INVENTORY_FILE="$inventory_file" bash -c '
    source "$1"
    TARGET_INVENTORY_VALIDATE "$2" || exit 1
    for target in "${TARGET_NAMES[@]}"; do
      printf "%-18s %-12s %-8s\n" "$target" "external" "${TARGET_TRANSPORT[$target]}"
    done
  ' _ "$INVENTORY_SCRIPT" "$inventory_file"
}

list_proxmox() {
  if command -v pct >/dev/null 2>&1; then
    pct list 2>/dev/null | awk 'NR > 1 {printf "%-18s %-12s %-8s\n", $1, "lxc", "pct"}'
  fi
  if command -v qm >/dev/null 2>&1; then
    qm list 2>/dev/null | awk 'NR > 1 {printf "%-18s %-12s %-8s\n", $1, "vm", "qga/ssh"}'
  fi
}

list_targets() {
  printf '%-18s %-12s %-8s\n' "Target" "Type" "Transport"
  printf '%-18s %-12s %-8s\n' "------" "----" "---------"
  printf '%-18s %-12s %-8s\n' "local-host" "host" "local"
  list_proxmox
  list_inventory
}

inventory_target_exists() {
  local target="$1" inventory_file="$LOCAL_FILES/targets.conf"
  [[ -f "$inventory_file" && -f "$INVENTORY_SCRIPT" ]] || return 1
  TARGET_INVENTORY_FILE="$inventory_file" bash -c '
    source "$1"
    TARGET_INVENTORY_VALIDATE "$2" >/dev/null 2>&1 || exit 1
    for target in "${TARGET_NAMES[@]}"; do
      [[ "$target" == "$3" ]] && exit 0
    done
    exit 1
  ' _ "$INVENTORY_SCRIPT" "$inventory_file" "$target"
}

inventory_targets() {
  local inventory_file="$LOCAL_FILES/targets.conf"
  [[ -f "$inventory_file" && -f "$INVENTORY_SCRIPT" ]] || return 0
  TARGET_INVENTORY_FILE="$inventory_file" bash -c '
    source "$1"
    TARGET_INVENTORY_VALIDATE "$2" || exit 1
    printf "%s\n" "${TARGET_NAMES[@]}"
  ' _ "$INVENTORY_SCRIPT" "$inventory_file"
}

status_json() {
  require_file "$STATUS_FILE" "status file" || return 4
  if ! python3 - "$STATUS_FILE" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as status_file:
    json.load(status_file)
PY
  then
    printf 'ultimate-updater: status file is not valid JSON: %s\n' "$STATUS_FILE" >&2
    return 4
  fi
  cat "$STATUS_FILE"
}

status_human() {
  local status_result=0
  if [[ ! -f "$STATUS_FILE" ]]; then
    printf 'ultimate-updater: status file is not available: %s\n' "$STATUS_FILE" >&2
    status_result=4
  elif ! python3 - "$STATUS_FILE" <<'PY'
import json
import sys

try:
    with open(sys.argv[1], encoding="utf-8") as status_file:
        payload = json.load(status_file)
except (OSError, ValueError) as error:
    print(f"ultimate-updater: cannot read status file: {error}", file=sys.stderr)
    raise SystemExit(4)

targets = payload.get("targets")
if not isinstance(targets, list):
    print("ultimate-updater: status file has no target list", file=sys.stderr)
    raise SystemExit(4)

print(f"Status schema {payload.get('schema_version', 'unknown')}" )
print(f"Generated: {payload.get('generated_at') or 'unknown'}")
print(f"{'Target':<18} {'Reachable':<11} {'Updates':<9} {'Status':<18} Last check")
print(f"{'------':<18} {'---------':<11} {'-------':<9} {'------':<18} ----------")
for target in targets:
    updates = target.get("updates") or {}
    available = updates.get("available")
    reachable = target.get("reachable")
    reachable_text = "yes" if reachable is True else "no" if reachable is False else "unknown"
    updates_text = str(available) if available is not None else "unknown"
    print(f"{str(target.get('id') or 'unknown'):<18} {reachable_text:<11} "
          f"{updates_text:<9} {str(target.get('check_status') or 'not_checked'):<18} "
          f"{target.get('last_check') or 'unknown'}")
PY
  then
    printf 'ultimate-updater: status file is not valid or readable: %s\n' "$STATUS_FILE" >&2
    status_result=4
  fi
  if [[ -x "$JOB_RUNNER" ]]; then
    local jobs
    jobs=$("$JOB_RUNNER" list 2>/dev/null || true)
    if [[ -n "$jobs" ]]; then
      printf '\nUpdate jobs\n'
      printf '%-55s %-12s %-12s %-20s\n' "Job" "Target" "State" "Exit"
      while IFS=$'\t' read -r unit target state _ _ exit_code; do
        printf '%-55s %-12s %-12s %-20s\n' "$unit" "$target" "$state" "${exit_code:-pending}"
      done <<< "$jobs"
    fi
  fi
  return "$status_result"
}

resolve_target_kind() {
  local target="$1" proxmox_kind="" inventory_kind=false
  if [[ "$target" == host || "$target" == local-host ]]; then
    printf '%s\n' host
    return 0
  fi
  if command -v pct >/dev/null 2>&1 && pct config "$target" >/dev/null 2>&1; then proxmox_kind=container; fi
  if command -v qm >/dev/null 2>&1 && qm config "$target" >/dev/null 2>&1; then proxmox_kind=vm; fi
  if inventory_target_exists "$target"; then inventory_kind=true; fi
  if [[ -n "$proxmox_kind" && "$inventory_kind" == true ]]; then
    printf 'ultimate-updater: target is ambiguous in Proxmox and inventory: %s\n' "$target" >&2
    return 4
  fi
  if [[ -n "$proxmox_kind" ]]; then printf '%s\n' "$proxmox_kind"; return 0; fi
  if [[ "$inventory_kind" == true ]]; then printf '%s\n' external; return 0; fi
  return 1
}

run_external_checks() {
  local target result=0 targets
  targets=$(inventory_targets) || return 1
  [[ -n "$targets" ]] || return 0
  require_file "$EXTERNAL_APT_SCRIPT" "external Linux helper" || return 1
  while IFS= read -r target; do
    [[ -n "$target" ]] || continue
    "$EXTERNAL_APT_SCRIPT" check "$target" || result=$?
  done <<< "$targets"
  return "$result"
}

run_check() {
  local target="${1:-}" kind
  if [[ -z "$target" ]]; then
    require_file "$CHECK_SCRIPT" "check script" || return 1
    local check_result external_result
    UU_DEFER_NOTIFICATION=true "$CHECK_SCRIPT"; check_result=$?
    run_external_checks; external_result=$?
    if declare -f STATUS_MODEL_SEND_NOTIFICATION >/dev/null 2>&1; then
      STATUS_MODEL_SEND_NOTIFICATION "$STATUS_FILE" "$LOCAL_FILES/update.conf" || true
    fi
    [[ "$check_result" -eq 0 ]] || return "$check_result"
    return "$external_result"
  fi
  kind=$(resolve_target_kind "$target") || {
    printf 'ultimate-updater: target not found: %s\n' "$target" >&2
    return 3
  }
  case "$kind" in
    host) require_file "$CHECK_SCRIPT" "check script" || return 1; STATUS_MODEL_PARTIAL=true "$CHECK_SCRIPT" chost ;;
    container) require_file "$CHECK_SCRIPT" "check script" || return 1; STATUS_MODEL_PARTIAL=true "$CHECK_SCRIPT" ccontainer "$target" ;;
    vm) require_file "$CHECK_SCRIPT" "check script" || return 1; STATUS_MODEL_PARTIAL=true "$CHECK_SCRIPT" cvm "$target" ;;
    external) require_file "$EXTERNAL_APT_SCRIPT" "external Linux helper" || return 1; "$EXTERNAL_APT_SCRIPT" check "$target" ;;
  esac
}

run_update() {
  require_file "$JOB_RUNNER" "job runner" || return 1
  local target="${1:-}" kind
  [[ -n "$target" ]] || { usage >&2; return 2; }
  [[ "$EUID" -eq 0 ]] || { printf 'ultimate-updater: update jobs require root\n' >&2; return 2; }
  kind=$(resolve_target_kind "$target") || {
    printf 'ultimate-updater: target not found: %s\n' "$target" >&2
    return 3
  }
  case "$kind" in
    host|container|vm) require_file "$UPDATE_SCRIPT" "update script" || return 1; "$JOB_RUNNER" start "$UPDATE_SCRIPT" "$([[ "$kind" == host ]] && printf host || printf '%s' "$target")" ;;
    external) require_file "$EXTERNAL_APT_SCRIPT" "external Linux helper" || return 1; "$JOB_RUNNER" start "$EXTERNAL_APT_SCRIPT" "$target" ;;
  esac
}

command="${1:-help}"
case "$command" in
  help|-h|--help)
    [[ $# -le 1 ]] || { usage >&2; exit 2; }
    usage
    ;;
  list)
    [[ $# -eq 1 ]] || { usage >&2; exit 2; }
    list_targets
    ;;
  status)
    case "${2:-}" in
      "") [[ $# -eq 1 ]] || { usage >&2; exit 2; }; status_human ;;
      --json) [[ $# -eq 2 ]] || { usage >&2; exit 2; }; status_json ;;
      *) usage >&2; exit 2 ;;
    esac
    ;;
  check)
    [[ $# -le 2 ]] || { usage >&2; exit 2; }
    run_check "${2:-}"
    ;;
  update)
    [[ $# -eq 2 ]] || { usage >&2; exit 2; }
    run_update "$2"
    ;;
  *)
    printf 'ultimate-updater: unknown command: %s\n' "$command" >&2
    usage >&2
    exit 2
    ;;
esac
