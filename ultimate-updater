remote_update_job() {
  local remote_target="$1" target="$2" node="$3" host="${REMOTE_NODE_HOST:-$4}"
  local port="${REMOTE_NODE_PORT:-$(configured_ssh_port)}"
  local user="${REMOTE_NODE_USER:-root}" output job_unit command remote_update_dir source scope_env=''
  local -a ssh_args=("${REMOTE_NODE_ARGS[@]}")
  remote_update_dir="/tmp/ultimate-updater-update-node-$$-$RANDOM-$RANDOM"
  if ! timeout 15 ssh "${ssh_args[@]}" -p "$port" "$user@$host" "mkdir -p -- '$remote_update_dir'"; then
    printf 'Could not prepare remote update workspace on %s.\n' "$node" >&2
    return 6
  fi
  for source in \
    "$JOB_RUNNER" "$UPDATE_SCRIPT" "$LOCAL_FILES/update.conf" \
    "$LOCAL_FILES/tag-filter.sh" "$LOCAL_FILES/status-model.sh" \
    "$LOCAL_FILES/check-updates.sh" "$LOCAL_FILES/ultimate-updater" \
    "$LOCAL_FILES/target-runtime.sh" "$LOCAL_FILES/cluster-target.sh" \
    "$LOCAL_FILES/internal-ssh.sh" "$LOCAL_FILES/update-extras.sh" \
    "$LOCAL_FILES/windows-update.sh"; do
    [[ -f "$source" ]] || continue
    if ! timeout 15 scp -q "${ssh_args[@]}" -P "$port" "$source" \
      "$user@$host:$remote_update_dir/$(basename -- "$source")"; then
      timeout 15 ssh "${ssh_args[@]}" -p "$port" "$user@$host" "rm -rf -- '$remote_update_dir'" >/dev/null 2>&1 || true
      printf 'Could not transfer remote update helper to %s.\n' "$node" >&2
      return 6
    fi
  done
  if ! timeout 15 ssh "${ssh_args[@]}" -p "$port" "$user@$host" \
    "chmod 750 '$remote_update_dir/job-runner.sh' '$remote_update_dir/update.sh'"; then
    timeout 15 ssh "${ssh_args[@]}" -p "$port" "$user@$host" "rm -rf -- '$remote_update_dir'" >/dev/null 2>&1 || true
    printf 'Could not prepare remote update runner on %s.\n' "$node" >&2
    return 6
  fi
  if [[ "$remote_target" == host ]]; then
    scope_env='UU_UPDATE_SCOPE=host '
  fi
  printf -v command 'exec /usr/bin/env %sUU_LOCAL_FILES=%q UU_REMOTE_WORK_DIR=%q %q start %q %q' \
    "$scope_env" "$remote_update_dir" "$remote_update_dir" "$remote_update_dir/job-runner.sh" \
    "$remote_update_dir/update.sh" "$remote_target"
  if ! output=$(timeout 30 ssh "${ssh_args[@]}" -p "$port" "$user@$host" "$command"); then
    timeout 15 ssh "${ssh_args[@]}" -p "$port" "$user@$host" "rm -rf -- '$remote_update_dir'" >/dev/null 2>&1 || true
    printf 'Could not start update job on %s.\n' "$node" >&2
    return 6
  fi
  printf '%s\n' "$output"
  job_unit=$(printf '%s\n' "$output" | sed -n 's/^Job:[[:space:]]*//p' | head -n 1)
  if [[ ! "$job_unit" =~ ^ultimate-updater-update-[A-Za-z0-9_.-]+$ ]] ||
    ! "$JOB_RUNNER" record-remote "$job_unit" "$target" "$node" "$host" "$port"; then
    printf 'Remote job started but could not be referenced locally.\n' >&2
    return 7
  fi
}

